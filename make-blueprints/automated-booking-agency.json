{
  "name": "Prospect Outreach & Contact",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:watchRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "from": 0,
        "limit": 10,
        "sheetId": "Prospects",
        "includesHeaders": "yes",
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING"
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Google connection",
              "data": {
                "scoped": "true",
                "connection": "google"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFilter",
      "version": 1,
      "parameters": {
        "conditions": [
          [
            {
              "a": "{{1.`9`}}",
              "b": "New",
              "o": "text:equal"
            }
          ]
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      },
      "filter": {
        "name": "Only New Prospects",
        "conditions": [
          [
            {
              "a": "{{1.`9`}}",
              "b": "New",
              "o": "text:equal"
            }
          ]
        ]
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 4,
              "module": "gmail:ActionSendEmail",
              "version": 1,
              "parameters": {
                "__IMTCONN__": 0
              },
              "mapper": {
                "to": "{{1.`3`}}",
                "cc": "",
                "bcc": "",
                "from": "",
                "subject": "Booking Opportunity — {{1.`5`}} for {{1.`7`}}",
                "content": "<p>Hi {{1.`1`}},</p>\n<p>I'm reaching out from <strong>[Your Agency Name]</strong> regarding your upcoming <strong>{{1.`7`}}</strong> on <strong>{{1.`6`}}</strong>.</p>\n<p>We have top-tier <strong>{{1.`5`}}</strong> talent available that would be a perfect fit for your event. I'd love to schedule a quick call to discuss details and availability.</p>\n<p>You can book a time directly here: <a href=\"[YOUR_CALENDLY_LINK]\">Schedule a Call</a></p>\n<p>Looking forward to connecting!</p>\n<p>Best regards,<br/>[Your Name]<br/>[Your Agency]</p>",
                "attachments": []
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": -300
                },
                "restore": {
                  "parameters": {
                    "__IMTCONN__": {
                      "label": "My Gmail connection",
                      "data": {
                        "scoped": "true",
                        "connection": "google-email"
                      }
                    }
                  }
                },
                "parameters": [
                  {
                    "name": "__IMTCONN__",
                    "type": "account",
                    "label": "Connection",
                    "required": true
                  }
                ],
                "expect": [
                  { "name": "to", "type": "text", "label": "To", "required": true },
                  { "name": "subject", "type": "text", "label": "Subject", "required": true },
                  { "name": "content", "type": "text", "label": "Content" }
                ]
              }
            },
            {
              "id": 5,
              "module": "builtin:Sleep",
              "version": 1,
              "parameters": {
                "delay": 259200
              },
              "metadata": {
                "designer": {
                  "x": 1200,
                  "y": -300
                }
              }
            },
            {
              "id": 6,
              "module": "gmail:ActionSendEmail",
              "version": 1,
              "parameters": {
                "__IMTCONN__": 0
              },
              "mapper": {
                "to": "{{1.`3`}}",
                "cc": "",
                "bcc": "",
                "from": "",
                "subject": "Re: Booking Opportunity — {{1.`5`}} for {{1.`7`}}",
                "content": "<p>Hi {{1.`1`}},</p>\n<p>Just following up on my earlier email about your <strong>{{1.`7`}}</strong>. We still have availability for <strong>{{1.`5`}}</strong> talent on <strong>{{1.`6`}}</strong>.</p>\n<p>Would you like to hop on a quick 10-minute call this week? Book a time here: <a href=\"[YOUR_CALENDLY_LINK]\">Schedule a Call</a></p>\n<p>Best,<br/>[Your Name]</p>",
                "attachments": []
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": -300
                },
                "restore": {
                  "parameters": {
                    "__IMTCONN__": {
                      "label": "My Gmail connection",
                      "data": {
                        "scoped": "true",
                        "connection": "google-email"
                      }
                    }
                  }
                },
                "parameters": [
                  {
                    "name": "__IMTCONN__",
                    "type": "account",
                    "label": "Connection",
                    "required": true
                  }
                ]
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 7,
              "module": "twilio:ActionMakeCall",
              "version": 1,
              "parameters": {
                "__IMTCONN__": 0
              },
              "mapper": {
                "to": "{{1.`4`}}",
                "from": "[YOUR_TWILIO_PHONE_NUMBER]",
                "twiml": "<Response><Say voice=\"alice\">Hello {{1.`1`}}. This is a courtesy call from Your Agency Name regarding your upcoming {{1.`7`}}. We have {{1.`5`}} talent available for your event on {{1.`6`}}. Please check your email for details or press 1 to be connected with a booking agent.</Say><Gather numDigits=\"1\" action=\"[YOUR_WEBHOOK_URL]\"><Say>Press 1 to speak with an agent now.</Say></Gather></Response>"
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": 0
                },
                "restore": {
                  "parameters": {
                    "__IMTCONN__": {
                      "label": "My Twilio connection",
                      "data": {
                        "scoped": "true",
                        "connection": "twilio"
                      }
                    }
                  }
                },
                "parameters": [
                  {
                    "name": "__IMTCONN__",
                    "type": "account",
                    "label": "Connection",
                    "required": true
                  }
                ]
              }
            },
            {
              "id": 8,
              "module": "google-sheets:updateRow",
              "version": 2,
              "parameters": {
                "__IMTCONN__": 0
              },
              "mapper": {
                "sheetId": "Prospects",
                "rowNumber": "{{1.__ROW_NUMBER__}}",
                "values": {
                  "9": "Contacted",
                  "10": "{{now}}",
                  "11": "Phone + Email"
                }
              },
              "metadata": {
                "designer": {
                  "x": 1200,
                  "y": 0
                },
                "restore": {
                  "parameters": {
                    "__IMTCONN__": {
                      "label": "My Google connection",
                      "data": {
                        "scoped": "true",
                        "connection": "google"
                      }
                    }
                  }
                },
                "parameters": [
                  {
                    "name": "__IMTCONN__",
                    "type": "account",
                    "label": "Connection",
                    "required": true
                  }
                ]
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 9,
              "module": "hubspot:ActionCreateUpdateContact",
              "version": 3,
              "parameters": {
                "__IMTCONN__": 0
              },
              "mapper": {
                "email": "{{1.`3`}}",
                "firstname": "{{1.`1`}}",
                "company": "{{1.`2`}}",
                "phone": "{{1.`4`}}",
                "lifecyclestage": "lead",
                "customProperties": [
                  { "property": "talent_type_needed", "value": "{{1.`5`}}" },
                  { "property": "event_date", "value": "{{1.`6`}}" },
                  { "property": "event_type", "value": "{{1.`7`}}" },
                  { "property": "budget", "value": "{{1.`8`}}" },
                  { "property": "lead_source", "value": "Automated Outreach" }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": 300
                },
                "restore": {
                  "parameters": {
                    "__IMTCONN__": {
                      "label": "My HubSpot connection",
                      "data": {
                        "scoped": "true",
                        "connection": "hubspot"
                      }
                    }
                  }
                },
                "parameters": [
                  {
                    "name": "__IMTCONN__",
                    "type": "account",
                    "label": "Connection",
                    "required": true
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us1.make.com"
  }
}
