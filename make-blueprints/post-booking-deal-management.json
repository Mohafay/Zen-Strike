{
  "name": "Post-Booking Deal Management",
  "flow": [
    {
      "id": 1,
      "module": "hubspot:TriggerWatchDeals",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 0,
        "pipeline": "",
        "dealstage": "closedwon",
        "limit": 10
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My HubSpot connection",
              "data": {
                "scoped": "true",
                "connection": "hubspot"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "hubspot:ActionGetContact",
      "version": 3,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "contactId": "{{1.associations.contacts[0]}}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My HubSpot connection",
              "data": {
                "scoped": "true",
                "connection": "hubspot"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 3,
      "module": "gmail:ActionSendEmail",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "to": "{{2.email}}",
        "subject": "Booking Confirmed! — {{1.talent_type}} for {{1.event_date}}",
        "content": "<p>Hi {{2.firstname}},</p>\n<p>Your booking is officially confirmed! Here's a summary:</p>\n<table style=\"border-collapse:collapse;width:100%\">\n<tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>Talent</strong></td><td style=\"padding:8px;border:1px solid #ddd\">{{1.talent_type}}</td></tr>\n<tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>Event Date</strong></td><td style=\"padding:8px;border:1px solid #ddd\">{{1.event_date}}</td></tr>\n<tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>Venue</strong></td><td style=\"padding:8px;border:1px solid #ddd\">{{1.event_venue}}</td></tr>\n<tr><td style=\"padding:8px;border:1px solid #ddd\"><strong>Amount</strong></td><td style=\"padding:8px;border:1px solid #ddd\">${{1.amount}}</td></tr>\n</table>\n<p>We'll be in touch closer to the event date with logistics details. If you have any questions, just reply to this email.</p>\n<p>Thank you for choosing [Your Agency]!</p>",
        "attachments": []
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": -150
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Gmail connection",
              "data": {
                "scoped": "true",
                "connection": "google-email"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 4,
      "module": "gmail:ActionSendEmail",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "to": "[TALENT_EMAIL_ADDRESS]",
        "subject": "New Booking Assignment — {{1.event_date}} at {{1.event_venue}}",
        "content": "<p>Hi,</p>\n<p>You've been booked for an upcoming event. Here are the details:</p>\n<ul>\n<li><strong>Client:</strong> {{2.firstname}} {{2.lastname}}</li>\n<li><strong>Event Date:</strong> {{1.event_date}}</li>\n<li><strong>Venue:</strong> {{1.event_venue}}</li>\n<li><strong>Deal:</strong> {{1.dealname}}</li>\n</ul>\n<p>Please confirm your availability by replying to this email within 24 hours.</p>\n<p>Thanks,<br/>[Your Agency]</p>",
        "attachments": []
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 150
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Gmail connection",
              "data": {
                "scoped": "true",
                "connection": "google-email"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 5,
      "module": "google-sheets:ActionAddRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "sheetId": "Confirmed Bookings",
        "includesHeaders": "yes",
        "values": [
          "{{1.dealId}}",
          "{{2.firstname}} {{2.lastname}}",
          "{{2.email}}",
          "{{1.talent_type}}",
          "{{1.event_date}}",
          "{{1.event_venue}}",
          "{{1.amount}}",
          "Confirmed",
          "{{now}}"
        ]
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": -150
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Google connection",
              "data": {
                "scoped": "true",
                "connection": "google"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 6,
      "module": "google-calendar:ActionCreateEvent",
      "version": 4,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "calendarId": "primary",
        "summary": "EVENT: {{1.talent_type}} — {{2.firstname}} at {{1.event_venue}}",
        "description": "Client: {{2.firstname}} {{2.lastname}}\nTalent: {{1.talent_type}}\nVenue: {{1.event_venue}}\nDeal Value: ${{1.amount}}\nDeal ID: {{1.dealId}}",
        "start": "{{1.event_date}}",
        "end": "{{1.event_date}}",
        "allDay": true,
        "colorId": "10",
        "sendUpdates": "none"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 150
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Google Calendar connection",
              "data": {
                "scoped": "true",
                "connection": "google-calendar"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 7,
      "module": "slack:ActionPostMessage",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "channel": "#bookings",
        "text": "*Deal Closed!*\n- Client: {{2.firstname}} {{2.lastname}}\n- Talent: {{1.talent_type}}\n- Event: {{1.event_date}} at {{1.event_venue}}\n- Value: ${{1.amount}}"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Slack connection",
              "data": {
                "scoped": "true",
                "connection": "slack"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us1.make.com"
  }
}
