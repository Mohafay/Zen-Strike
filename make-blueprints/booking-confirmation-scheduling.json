{
  "name": "Booking Confirmation & Scheduling",
  "flow": [
    {
      "id": 1,
      "module": "calendly:watchEvents",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 0,
        "scope": "user",
        "events": ["invitee.created"]
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Calendly connection",
              "data": {
                "scoped": "true",
                "connection": "calendly"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "google-sheets:ActionSearchRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "sheetId": "Prospects",
        "includesHeaders": "yes",
        "filter": [
          {
            "column": "3",
            "operator": "equals",
            "value": "{{1.invitee_email}}"
          }
        ],
        "sortOrder": "asc",
        "limit": 1
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Google connection",
              "data": {
                "scoped": "true",
                "connection": "google"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 3,
      "module": "google-calendar:ActionCreateEvent",
      "version": 4,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "calendarId": "primary",
        "summary": "Booking Call — {{1.invitee_name}} ({{2.`5`}})",
        "description": "Prospect: {{1.invitee_name}}\nCompany: {{2.`2`}}\nTalent Needed: {{2.`5`}}\nEvent Type: {{2.`7`}}\nEvent Date: {{2.`6`}}\nBudget: {{2.`8`}}\n\nNotes: Auto-scheduled via Make.com booking automation.",
        "start": "{{1.event_start_time}}",
        "end": "{{1.event_end_time}}",
        "attendees": [
          { "email": "{{1.invitee_email}}" }
        ],
        "sendUpdates": "all",
        "reminders": {
          "useDefault": false,
          "overrides": [
            { "method": "email", "minutes": 60 },
            { "method": "popup", "minutes": 15 }
          ]
        }
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Google Calendar connection",
              "data": {
                "scoped": "true",
                "connection": "google-calendar"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 4,
      "module": "gmail:ActionSendEmail",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "to": "{{1.invitee_email}}",
        "subject": "Your Booking Call is Confirmed! — {{2.`5`}} for {{2.`7`}}",
        "content": "<p>Hi {{1.invitee_name}},</p>\n<p>Great news! Your booking consultation call is confirmed for <strong>{{formatDate(1.event_start_time; \"MMMM Do, YYYY [at] h:mm A\")}}</strong>.</p>\n<p>Here's what we'll cover:</p>\n<ul>\n<li>Available {{2.`5`}} talent for your {{2.`7`}}</li>\n<li>Pricing and packages within your budget</li>\n<li>Timeline and logistics for {{2.`6`}}</li>\n</ul>\n<p>If you need to reschedule, simply use the link in your original calendar invite.</p>\n<p>Looking forward to it!</p>\n<p>Best,<br/>[Your Name]<br/>[Your Agency]</p>",
        "attachments": []
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Gmail connection",
              "data": {
                "scoped": "true",
                "connection": "google-email"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 5,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "sheetId": "Prospects",
        "rowNumber": "{{2.__ROW_NUMBER__}}",
        "values": {
          "9": "Call Scheduled",
          "10": "{{1.event_start_time}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": -150
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Google connection",
              "data": {
                "scoped": "true",
                "connection": "google"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 6,
      "module": "hubspot:ActionUpdateContact",
      "version": 3,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "email": "{{1.invitee_email}}",
        "lifecyclestage": "salesqualifiedlead",
        "customProperties": [
          { "property": "hs_lead_status", "value": "Call Scheduled" },
          { "property": "scheduled_call_date", "value": "{{1.event_start_time}}" }
        ]
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 150
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My HubSpot connection",
              "data": {
                "scoped": "true",
                "connection": "hubspot"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 7,
      "module": "slack:ActionPostMessage",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "channel": "#bookings",
        "text": "*New Booking Call Scheduled!*\n- Prospect: {{1.invitee_name}}\n- Company: {{2.`2`}}\n- Talent: {{2.`5`}}\n- Event: {{2.`7`}} on {{2.`6`}}\n- Call Time: {{formatDate(1.event_start_time; \"MMM Do [at] h:mm A\")}}\n- Budget: {{2.`8`}}"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Slack connection",
              "data": {
                "scoped": "true",
                "connection": "slack"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us1.make.com"
  }
}
