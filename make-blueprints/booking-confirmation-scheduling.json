{
  "name": "Booking Scheduling — Calendly to Calendar",
  "flow": [
    {
      "id": 1,
      "module": "calendly:watchEvents",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 0,
        "scope": "user",
        "events": ["invitee.created"]
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Calendly connection",
              "data": {
                "scoped": "true",
                "connection": "calendly"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "google-calendar:ActionCreateEvent",
      "version": 4,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "calendarId": "primary",
        "summary": "Booking Call — {{1.invitee_name}}",
        "description": "Prospect: {{1.invitee_name}}\nEmail: {{1.invitee_email}}\n\nAuto-scheduled from Calendly.",
        "start": "{{1.event_start_time}}",
        "end": "{{1.event_end_time}}",
        "attendees": [
          { "email": "{{1.invitee_email}}" }
        ],
        "sendUpdates": "all",
        "reminders": {
          "useDefault": false,
          "overrides": [
            { "method": "email", "minutes": 60 },
            { "method": "popup", "minutes": 15 }
          ]
        }
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Google Calendar connection",
              "data": {
                "scoped": "true",
                "connection": "google-calendar"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 3,
      "module": "gmail:ActionSendEmail",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "to": "{{1.invitee_email}}",
        "subject": "Your Booking Call is Confirmed!",
        "content": "<p>Hi {{1.invitee_name}},</p>\n<p>Your booking call is confirmed for <strong>{{formatDate(1.event_start_time; \"MMMM Do, YYYY [at] h:mm A\")}}</strong>.</p>\n<p>We'll discuss talent availability, pricing, and logistics for your event.</p>\n<p>If you need to reschedule, use the link in your Calendly confirmation.</p>\n<p>Looking forward to it!</p>\n<p>Best,<br/>[Your Name]<br/>[Your Agency]</p>",
        "attachments": []
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Gmail connection",
              "data": {
                "scoped": "true",
                "connection": "google-email"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 4,
      "module": "google-sheets:ActionSearchRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "sheetId": "Prospects",
        "includesHeaders": "yes",
        "filter": [
          {
            "column": "3",
            "operator": "equals",
            "value": "{{1.invitee_email}}"
          }
        ],
        "limit": 1
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Google connection",
              "data": {
                "scoped": "true",
                "connection": "google"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 5,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "sheetId": "Prospects",
        "rowNumber": "{{4.__ROW_NUMBER__}}",
        "values": {
          "8": "Booked",
          "9": "{{1.event_start_time}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "label": "My Google connection",
              "data": {
                "scoped": "true",
                "connection": "google"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account",
            "label": "Connection",
            "required": true
          }
        ]
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us1.make.com"
  }
}
